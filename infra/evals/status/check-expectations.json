{
  "schemaVersion": 1,
  "checks": {
    "api-health": {
      "description": "The server health endpoint returns an ok status payload.",
      "requiredEvidence": ["status"],
      "assertions": [{ "path": "status", "equals": "ok" }]
    },
    "auth-session": {
      "description": "Authenticated session returns a user id and response keys.",
      "requiredEvidence": ["userPresent", "keys"],
      "assertions": [
        { "path": "userPresent", "equals": true },
        { "path": "keys", "nonEmpty": true }
      ]
    },
    "system-info": {
      "description": "System info endpoint returns a JSON object.",
      "requiredEvidence": ["keys"]
    },
    "auth-validate": {
      "description": "Auth validation refresh returns a user id.",
      "requiredEvidence": ["userIdPresent"],
      "assertions": [
        { "path": "userIdPresent", "equals": true }
      ]
    },
    "orgs-list": {
      "description": "The current user resolves at least one organization membership.",
      "requiredEvidence": ["orgId", "orgCount"],
      "assertions": [{ "path": "orgCount", "min": 1 }]
    },
    "user-profile": {
      "description": "The current user profile endpoint returns a user identifier.",
      "requiredEvidence": ["userIdPresent", "keys"],
      "assertions": [
        { "path": "userIdPresent", "equals": true },
        { "path": "keys", "nonEmpty": true }
      ]
    },
    "public-setup": {
      "description": "Public guest setup mints a token and reports turn limits.",
      "requiredEvidence": ["tokenPresent", "turnCount", "limit"],
      "assertions": [
        { "path": "tokenPresent", "equals": true },
        { "path": "limit", "min": 1 }
      ]
    },
    "public-chat-stream": {
      "description": "Public chat emits at least one text delta frame.",
      "requiredEvidence": ["frameTypes", "textSample"],
      "assertions": [
        { "path": "frameTypes", "contains": "text_delta" },
        { "path": "textSample", "nonEmpty": true }
      ]
    },
    "public-feedback-api": {
      "description": "Public feedback API returns a list count.",
      "requiredEvidence": ["count"]
    },
    "public-blog-api": {
      "description": "Public blog API returns a list count.",
      "requiredEvidence": ["count"]
    },
    "public-content-details": {
      "description": "Public blog, OS, and docs list endpoints each expose a slug that resolves through the matching detail endpoint.",
      "requiredEvidence": ["blogCount", "blogDetailChecked", "blogDetailIdPresent", "osCount", "osDetailChecked", "osDetailIdPresent", "docsCount", "docsDetailChecked", "docsDetailIdPresent", "publicModelCount"],
      "assertions": [
        { "path": "blogDetailChecked", "equals": true },
        { "path": "blogDetailIdPresent", "equals": true },
        { "path": "osDetailChecked", "equals": true },
        { "path": "osDetailIdPresent", "equals": true },
        { "path": "docsDetailChecked", "equals": true },
        { "path": "docsDetailIdPresent", "equals": true }
      ]
    },
    "public-x402-models": {
      "description": "Public x402 model discovery returns an OpenAI-shaped model list.",
      "requiredEvidence": ["modelCount", "object"],
      "assertions": [
        { "path": "object", "equals": "list" },
        { "path": "modelCount", "min": 1 }
      ]
    },
    "public-x402-payment-challenge": {
      "description": "Public x402 chat returns a payment challenge with wallet, network, asset, and amount fields before settlement.",
      "requiredEvidence": ["status", "payToPresent", "network", "asset", "amount", "acceptsCount", "paymentRequiredHeaderPresent"],
      "assertions": [
        { "path": "status", "equals": 402 },
        { "path": "payToPresent", "equals": true },
        { "path": "network", "nonEmpty": true },
        { "path": "asset", "nonEmpty": true },
        { "path": "amount", "nonEmpty": true },
        { "path": "acceptsCount", "min": 1 },
        { "path": "paymentRequiredHeaderPresent", "equals": true }
      ]
    },
    "local-agent-create": {
      "description": "Local agent creation returns agent identity and environment fields.",
      "requiredEvidence": ["orgId", "agentId", "machineType", "environment"]
    },
    "local-agent-runtime": {
      "description": "Local runtime test returns the expected response metadata.",
      "requiredEvidence": ["orgId", "agentId", "model", "provider", "message"],
      "assertions": [{ "path": "message", "containsIgnoreCase": "hello from aura" }]
    },
    "local-agent-permissions": {
      "description": "A local status probe agent persists the org-scoped, capability-free permissions bundle used by live evals.",
      "requiredEvidence": ["orgId", "agentId", "permissionsPresent", "orgScoped", "projectScopeEmpty", "agentScopeEmpty", "capabilityCount", "capabilityTypes"],
      "assertions": [
        { "path": "permissionsPresent", "equals": true },
        { "path": "orgScoped", "equals": true },
        { "path": "projectScopeEmpty", "equals": true },
        { "path": "agentScopeEmpty", "equals": true },
        { "path": "capabilityCount", "equals": 0 }
      ]
    },
    "project-agent-chat-stream": {
      "description": "A desktop release project-bound local agent instance streams a chat response, persists a session, and returns the expected phrase through the real project/session path.",
      "requiredEvidence": ["orgId", "projectId", "agentId", "agentInstanceId", "sessionId", "frameTypes", "textSample", "sessionCount", "expectedPhrase"],
      "assertions": [
        { "path": "orgId", "nonEmpty": true },
        { "path": "projectId", "nonEmpty": true },
        { "path": "agentId", "nonEmpty": true },
        { "path": "agentInstanceId", "nonEmpty": true },
        { "path": "sessionId", "nonEmpty": true },
        { "path": "frameTypes", "contains": "text_delta" },
        { "path": "textSample", "containsIgnoreCase": "hello from aura" },
        { "path": "sessionCount", "min": 1 },
        { "path": "expectedPhrase", "equals": "hello from aura" }
      ]
    },
    "project-agent-tool-roundtrip": {
      "description": "A desktop release project-bound local agent can use the bundled harness to write a file, read it back, run a shell command, and report the expected completion marker.",
      "requiredEvidence": ["orgId", "projectId", "agentId", "agentInstanceId", "frameTypes", "toolNames", "requiredToolsUsed", "writeOk", "readBackOk", "commandOk", "passMarkerPresent", "expectedFileName", "expectedFileMarker", "expectedShellMarker"],
      "assertions": [
        { "path": "orgId", "nonEmpty": true },
        { "path": "projectId", "nonEmpty": true },
        { "path": "agentId", "nonEmpty": true },
        { "path": "agentInstanceId", "nonEmpty": true },
        { "path": "toolNames", "contains": "write_file" },
        { "path": "toolNames", "contains": "read_file" },
        { "path": "toolNames", "contains": "run_command" },
        { "path": "requiredToolsUsed", "equals": true },
        { "path": "writeOk", "equals": true },
        { "path": "readBackOk", "equals": true },
        { "path": "commandOk", "equals": true },
        { "path": "passMarkerPresent", "equals": true },
        { "path": "expectedFileMarker", "equals": "AURA_TOOL_PROBE_OK" },
        { "path": "expectedShellMarker", "equals": "AURA_SHELL_PROBE_OK" }
      ]
    },
    "project-agent-a2a-roundtrip": {
      "description": "A desktop release project-bound local agent can discover another local agent, send it a message through send_to_agent, and observe the target reply routed back to the sender.",
      "requiredEvidence": ["orgId", "projectId", "plannerAgentId", "plannerAgentInstanceId", "reviewerAgentId", "reviewerAgentInstanceId", "frameTypes", "toolNames", "listAgentsUsed", "sendToAgentUsed", "delivered", "targetMatches", "reviewerAckObserved", "parentCallbackObserved", "expectedReply"],
      "assertions": [
        { "path": "plannerAgentId", "nonEmpty": true },
        { "path": "reviewerAgentId", "nonEmpty": true },
        { "path": "toolNames", "contains": "list_agents" },
        { "path": "toolNames", "contains": "send_to_agent" },
        { "path": "listAgentsUsed", "equals": true },
        { "path": "sendToAgentUsed", "equals": true },
        { "path": "delivered", "equals": true },
        { "path": "targetMatches", "equals": true },
        { "path": "reviewerAckObserved", "equals": true },
        { "path": "parentCallbackObserved", "equals": true },
        { "path": "expectedReply", "equals": "AURA_A2A_PROBE_ACK" }
      ]
    },
    "project-agent-subagent-roundtrip": {
      "description": "A desktop release project-bound local agent can spawn a foreground subagent with task, receive completion, and hydrate context usage/contents after the turn.",
      "requiredEvidence": ["orgId", "projectId", "agentId", "agentInstanceId", "frameTypes", "toolNames", "taskToolUsed", "subagentSpawned", "subagentCompleted", "subagentReturnedMarker", "contextUtilization", "subagentContextCount", "expectedReply"],
      "assertions": [
        { "path": "agentId", "nonEmpty": true },
        { "path": "agentInstanceId", "nonEmpty": true },
        { "path": "toolNames", "contains": "task" },
        { "path": "taskToolUsed", "equals": true },
        { "path": "subagentSpawned", "equals": true },
        { "path": "subagentCompleted", "equals": true },
        { "path": "subagentReturnedMarker", "equals": true },
        { "path": "contextUtilization", "min": 0.000001 },
        { "path": "subagentContextCount", "min": 1 },
        { "path": "expectedReply", "equals": "SUBAGENT_PROBE_OK" }
      ]
    },
    "session-share-public-read": {
      "description": "A desktop release project chat session can be shared and read through the anonymous public share endpoint.",
      "requiredEvidence": ["projectId", "agentInstanceId", "sessionId", "shareIdPresent", "shareUrlPresent", "publicMessageCount", "textSample"],
      "assertions": [
        { "path": "projectId", "nonEmpty": true },
        { "path": "agentInstanceId", "nonEmpty": true },
        { "path": "sessionId", "nonEmpty": true },
        { "path": "shareIdPresent", "equals": true },
        { "path": "shareUrlPresent", "equals": true },
        { "path": "publicMessageCount", "min": 1 }
      ]
    },
    "harness-memory-roundtrip": {
      "description": "The bundled desktop harness can create, read by key, update, list, and delete fact/event/procedure memory for a local agent.",
      "requiredEvidence": ["orgId", "agentId", "factId", "eventId", "procedureId", "factKey", "factByKeyMatches", "updatedFactPresent", "factCount", "eventCount", "procedureCount", "bySkillCount", "snapshotKeys", "statsKeys"],
      "assertions": [
        { "path": "orgId", "nonEmpty": true },
        { "path": "agentId", "nonEmpty": true },
        { "path": "factId", "nonEmpty": true },
        { "path": "eventId", "nonEmpty": true },
        { "path": "procedureId", "nonEmpty": true },
        { "path": "factKey", "nonEmpty": true },
        { "path": "factByKeyMatches", "equals": true },
        { "path": "updatedFactPresent", "equals": true },
        { "path": "factCount", "min": 1 },
        { "path": "eventCount", "min": 1 },
        { "path": "procedureCount", "min": 1 },
        { "path": "bySkillCount", "min": 1 },
        { "path": "snapshotKeys", "nonEmpty": true },
        { "path": "statsKeys", "nonEmpty": true }
      ]
    },
    "harness-skills-roundtrip": {
      "description": "The bundled desktop harness can create a user-authored skill, list it under My Skills, attach it to a local agent, then uninstall and delete it.",
      "requiredEvidence": ["orgId", "agentId", "skillName", "created", "registered", "installedOnAgent", "catalogCount", "mySkillsCount", "agentSkillsCount", "mineContainsSkill", "agentContainsSkill", "deleted"],
      "assertions": [
        { "path": "orgId", "nonEmpty": true },
        { "path": "agentId", "nonEmpty": true },
        { "path": "skillName", "nonEmpty": true },
        { "path": "created", "equals": true },
        { "path": "registered", "equals": true },
        { "path": "installedOnAgent", "equals": true },
        { "path": "mySkillsCount", "min": 1 },
        { "path": "agentSkillsCount", "min": 1 },
        { "path": "mineContainsSkill", "equals": true },
        { "path": "agentContainsSkill", "equals": true },
        { "path": "deleted", "equals": true }
      ]
    },
    "harness-skill-invocation": {
      "description": "A desktop release project-bound local agent receives an installed user-authored skill in context and follows it during a real chat turn.",
      "requiredEvidence": ["orgId", "projectId", "agentId", "agentInstanceId", "skillName", "created", "installedOnAgent", "frameTypes", "textSample", "expectedPhrase", "textMatches", "skillLabels", "skillInContext"],
      "assertions": [
        { "path": "orgId", "nonEmpty": true },
        { "path": "projectId", "nonEmpty": true },
        { "path": "agentId", "nonEmpty": true },
        { "path": "agentInstanceId", "nonEmpty": true },
        { "path": "skillName", "nonEmpty": true },
        { "path": "created", "equals": true },
        { "path": "installedOnAgent", "equals": true },
        { "path": "textMatches", "equals": true },
        { "path": "skillInContext", "equals": true },
        { "path": "expectedPhrase", "equals": "AURA_SKILL_PROBE_OK" }
      ]
    },
    "remote-agent-create": {
      "description": "Remote agent creation reaches a ready state.",
      "requiredEvidence": ["orgId", "agentId", "vmIdPresent", "remoteState"],
      "assertions": [
        { "path": "vmIdPresent", "equals": true },
        { "path": "remoteState", "oneOf": ["running", "idle", "ready"] }
      ]
    },
    "remote-agent-state": {
      "description": "Remote state polling returns ready and latest state payloads.",
      "requiredEvidence": ["orgId", "agentId", "readyState", "state"]
    },
    "remote-agent-runtime": {
      "description": "Remote runtime test returns the expected response metadata.",
      "requiredEvidence": ["orgId", "agentId", "model", "provider", "message"],
      "assertions": [{ "path": "message", "containsIgnoreCase": "hello from aura" }]
    },
    "project-crud": {
      "description": "Project create/get/list/delete roundtrip returns project identity.",
      "requiredEvidence": ["orgId", "projectId", "listed", "projectName"]
    },
    "spec-task-crud": {
      "description": "Spec and task create/read/delete roundtrip returns all ids.",
      "requiredEvidence": ["orgId", "projectId", "specId", "taskId", "specHashPresent", "taskCount"]
    },
    "project-stats": {
      "description": "Project stats endpoint returns a JSON object for a project.",
      "requiredEvidence": ["projectId", "keys"]
    },
    "loop-status": {
      "description": "Loop status endpoint returns a JSON object for a project.",
      "requiredEvidence": ["projectId", "keys"]
    },
    "notes-crud": {
      "description": "Project notes can create folders, create/update/transition notes, create/list/delete comments, and return the project note tree with preserved folder linkage.",
      "requiredEvidence": ["orgId", "projectId", "folderId", "noteId", "commentId", "folderLinked", "titleUpdated", "transitionStatus", "commentCount", "treeFolderCount", "treeNoteCount"],
      "assertions": [
        { "path": "orgId", "nonEmpty": true },
        { "path": "projectId", "nonEmpty": true },
        { "path": "folderId", "nonEmpty": true },
        { "path": "noteId", "nonEmpty": true },
        { "path": "commentId", "nonEmpty": true },
        { "path": "folderLinked", "equals": true },
        { "path": "titleUpdated", "equals": true },
        { "path": "commentCount", "min": 1 },
        { "path": "treeFolderCount", "min": 1 },
        { "path": "treeNoteCount", "min": 1 }
      ]
    },
    "process-list": {
      "description": "Process and folder list endpoints return list counts.",
      "requiredEvidence": ["processes", "folders"]
    },
    "process-crud": {
      "description": "Process create/list-nodes/delete roundtrip returns process identity and node count.",
      "requiredEvidence": ["projectId", "processId", "nodeCount"]
    },
    "process-run-lifecycle": {
      "description": "A desktop release can trigger a process run through the bundled harness automaton path and read the run, events, and artifact lists.",
      "requiredEvidence": ["orgId", "projectId", "agentId", "processId", "ignitionNodeId", "actionNodeId", "connectionId", "runId", "runStatus", "runCount", "eventCount", "artifactCount"],
      "assertions": [
        { "path": "orgId", "nonEmpty": true },
        { "path": "projectId", "nonEmpty": true },
        { "path": "agentId", "nonEmpty": true },
        { "path": "processId", "nonEmpty": true },
        { "path": "ignitionNodeId", "nonEmpty": true },
        { "path": "actionNodeId", "nonEmpty": true },
        { "path": "connectionId", "nonEmpty": true },
        { "path": "runId", "nonEmpty": true },
        { "path": "runStatus", "nonEmpty": true },
        { "path": "runCount", "min": 1 }
      ]
    },
    "model-matrix": {
      "description": "Every configured model is exercised and pass/total counts are recorded.",
      "requiredEvidence": ["orgId", "passed", "total", "allPassed", "failedModelCount", "failedModels", "expectedPhrase", "results"],
      "assertions": [
        { "path": "total", "min": 1 },
        { "path": "passed", "min": 1 },
        { "path": "allPassed", "equals": true },
        { "path": "failedModelCount", "equals": 0 },
        { "path": "expectedPhrase", "equals": "hello from aura" },
        { "path": "results", "nonEmpty": true }
      ]
    },
    "image-generation-stream": {
      "description": "Image generation stream emits frame types and a completion artifact signal in the runtime environment under test.",
      "requiredEvidence": ["frameTypes", "imageUrlPresent"],
      "assertions": [
        { "path": "frameTypes", "contains": "generation_completed" },
        { "path": "imageUrlPresent", "equals": true }
      ]
    },
    "marketplace-agents": {
      "description": "Marketplace agent catalog returns a list count.",
      "requiredEvidence": ["count"]
    },
    "harness-health": {
      "description": "Harness bootstrap health returns a JSON health payload.",
      "requiredEvidence": ["reachable", "status", "url"],
      "assertions": [
        { "path": "reachable", "equals": true },
        { "path": "status", "equals": 200 },
        { "path": "url", "nonEmpty": true }
      ]
    },
    "org-integrations-list": {
      "description": "Org integrations endpoint returns a list count for the current org.",
      "requiredEvidence": ["orgId", "count"]
    },
    "org-tool-actions-list": {
      "description": "Org tool actions endpoint returns a list count for the current org.",
      "requiredEvidence": ["orgId", "count"]
    },
    "org-tool-actions-contract": {
      "description": "Org tool action catalog returns well-formed tool entries or warnings without malformed tool definitions.",
      "requiredEvidence": ["orgId", "toolCount", "warningCount", "malformedToolCount", "sampleToolNames"],
      "assertions": [
        { "path": "orgId", "nonEmpty": true },
        { "path": "malformedToolCount", "equals": 0 }
      ]
    },
    "billing-status": {
      "description": "Subscription endpoint returns plan/subscription state or response keys.",
      "requiredEvidence": ["keys", "subscriptionKnown"],
      "assertions": [
        { "path": "keys", "nonEmpty": true },
        { "path": "subscriptionKnown", "equals": true }
      ]
    },
    "credits-balance": {
      "description": "Credits balance endpoint returns a JSON object for the current org.",
      "requiredEvidence": ["orgId", "keys"]
    },
    "billing-account-transactions": {
      "description": "Billing account and credit transaction read endpoints return account identity and a transaction envelope for the current org.",
      "requiredEvidence": ["orgId", "accountKeys", "accountIdPresent", "transactionsKnown", "transactionCount"],
      "assertions": [
        { "path": "orgId", "nonEmpty": true },
        { "path": "accountKeys", "nonEmpty": true },
        { "path": "accountIdPresent", "equals": true },
        { "path": "transactionsKnown", "equals": true }
      ]
    },
    "feedback-list": {
      "description": "Authenticated feedback endpoint returns a list count.",
      "requiredEvidence": ["count"]
    },
    "bug-reports-mine": {
      "description": "My bug reports endpoint returns a list count.",
      "requiredEvidence": ["count"]
    },
    "feed-list": {
      "description": "Feed endpoint returns a list count.",
      "requiredEvidence": ["count"]
    },
    "leaderboard": {
      "description": "Leaderboard endpoint returns a list count.",
      "requiredEvidence": ["count"]
    },
    "platform-stats": {
      "description": "Platform stats endpoint returns a JSON object.",
      "requiredEvidence": ["present", "keys"],
      "assertions": [{ "path": "present", "equals": true }]
    },
    "workspace-defaults": {
      "description": "Workspace defaults endpoint returns a workspace root signal.",
      "requiredEvidence": ["workspaceRootPresent"],
      "assertions": [{ "path": "workspaceRootPresent", "equals": true }]
    },
    "terminal-list": {
      "description": "Terminal list endpoint returns a list count.",
      "requiredEvidence": ["count"]
    },
    "desktop-update-runtime": {
      "description": "Desktop updater status, runtime config, and bundle diagnostics expose the release version and local harness wiring.",
      "requiredEvidence": ["currentVersionPresent", "channel", "updaterSupportedKnown", "localHarnessUrlPresent", "harnessBinaryPresent", "routerUrlPresent", "bundleOk", "bundleSupportedKnown"],
      "assertions": [
        { "path": "currentVersionPresent", "equals": true },
        { "path": "updaterSupportedKnown", "equals": true },
        { "path": "localHarnessUrlPresent", "equals": true },
        { "path": "harnessBinaryPresent", "equals": true },
        { "path": "routerUrlPresent", "equals": true },
        { "path": "bundleOk", "equals": true },
        { "path": "bundleSupportedKnown", "equals": true }
      ]
    },
    "active-streams": {
      "description": "Active stream registry returns a list count.",
      "requiredEvidence": ["count"]
    },
    "debug-projects": {
      "description": "Debug project index returns a JSON object.",
      "requiredEvidence": ["keys"]
    },
    "eval-summary-artifacts": {
      "description": "Eval artifact scan reports files and found counts.",
      "requiredEvidence": ["files", "existingCount", "expectedCount"],
      "assertions": [
        { "path": "existingCount", "min": 1 },
        { "path": "expectedCount", "min": 1 },
        { "path": "files", "nonEmpty": true }
      ]
    },
    "analytics-contract-artifacts": {
      "description": "Analytics registry, CI contract workflow, and desktop release analytics validation are present and include the core client/server event families.",
      "requiredEvidence": ["registryPresent", "eventCount", "engagedEventCount", "serverEventCount", "missingClientEvents", "missingClientEventCount", "missingServerEvents", "missingServerEventCount", "releaseRequiresAnalytics", "workflowRunsContracts"],
      "assertions": [
        { "path": "registryPresent", "equals": true },
        { "path": "eventCount", "min": 40 },
        { "path": "engagedEventCount", "min": 8 },
        { "path": "serverEventCount", "min": 3 },
        { "path": "missingClientEventCount", "equals": 0 },
        { "path": "missingServerEventCount", "equals": 0 },
        { "path": "releaseRequiresAnalytics", "equals": true },
        { "path": "workflowRunsContracts", "equals": true }
      ]
    },
    "published-observability-snapshot": {
      "description": "The published snapshot consumed by /observability is workflow-generated, fresh, and contains real feature data.",
      "requiredEvidence": ["schemaVersion", "overall", "generatedAtPresent", "source", "featureCount", "totalsFeatures", "unknownFeatureCount", "snapshotAgeMinutes", "hasLiveSource", "hasNonUnknownFeatureData", "snapshotUrl", "maxAgeMinutes"],
      "assertions": [
        { "path": "schemaVersion", "equals": 1 },
        { "path": "overall", "oneOf": ["operational", "degraded", "partial_outage", "major_outage", "maintenance"] },
        { "path": "generatedAtPresent", "equals": true },
        { "path": "source", "oneOf": ["github-actions", "desktop-nightly-release", "desktop-stable-release"] },
        { "path": "featureCount", "min": 1 },
        { "path": "totalsFeatures", "min": 1 },
        { "path": "snapshotAgeMinutes", "max": 300 },
        { "path": "hasLiveSource", "equals": true },
        { "path": "hasNonUnknownFeatureData", "equals": true },
        { "path": "snapshotUrl", "nonEmpty": true },
        { "path": "maxAgeMinutes", "equals": 300 }
      ]
    },
    "public-observability-page": {
      "description": "Public observability route serves the AURA app shell.",
      "requiredEvidence": ["status", "hasAppShell", "bodyLength"],
      "assertions": [
        { "path": "status", "equals": 200 },
        { "path": "hasAppShell", "equals": true },
        { "path": "bodyLength", "min": 1 }
      ]
    },
    "public-models-page": {
      "description": "Public models route serves the AURA app shell.",
      "requiredEvidence": ["status", "hasAppShell", "bodyLength"],
      "assertions": [
        { "path": "status", "equals": 200 },
        { "path": "hasAppShell", "equals": true },
        { "path": "bodyLength", "min": 1 }
      ]
    },
    "public-marketing-pages": {
      "description": "Public marketing route sweep returns per-route results.",
      "requiredEvidence": ["allRoutesOk", "routeCount", "failedRoutes", "failedRouteCount", "results"],
      "assertions": [
        { "path": "allRoutesOk", "equals": true },
        { "path": "routeCount", "min": 8 },
        { "path": "failedRouteCount", "equals": 0 },
        { "path": "results", "nonEmpty": true }
      ]
    }
  }
}
