  "rendered": {
    "title": "Sturdier chat recovery, cleaner model list, and hardened mobile releases",
    "intro": "Today's nightly focuses on making chat feel trustworthy when things go sideways — clearer restart wording, smarter reattachment after dropped streams, and a pruned model picker that only shows providers we can actually serve. Under the hood, the desktop harness now points at the right API address, and the mobile release pipelines got real guardrails around signing and store uploads.",
    "entries": [
      {
        "batch_id": "entry-1",
        "time_label": "9:38 AM",
        "started_at": "2026-09-11T16:38:54.000Z",
        "ended_at": "2026-09-11T16:38:54.000Z",
        "title": "Restart-turn wording and clearer council roles",
        "summary": "Chat now spells out what a retry actually does and rewrites the Council panel's role descriptions in plain language.",
        "items": [
          {
            "text": "Renamed the ambiguous \"Retry\" control to \"Restart turn\" across message bubbles, the stuck-stream pill, and the streaming indicator, with a tooltip clarifying that it resends the original prompt from the start rather than resuming unfinished work.",
            "commit_shas": [
              "a4907e2a1a4c8147a3d884dad2b2e97b203d1817"
            ],
            "confidence": "high"
          },
          {
            "text": "Replaced the Council panel's jargon (\"slot 0 contrasts / synthesizes\") with human-readable descriptions like \"1st member compares answers\" and allowed the header to wrap on narrow layouts.",
            "commit_shas": [
              "a4907e2a1a4c8147a3d884dad2b2e97b203d1817"
            ],
            "confidence": "high"
          }
        ]
      },
      {
        "batch_id": "entry-2",
        "time_label": "10:45 AM",
        "started_at": "2026-09-11T17:45:01.000Z",
        "ended_at": "2026-09-11T17:45:01.000Z",
        "title": "Desktop sidecar now inherits the bound API address",
        "summary": "The managed harness spawned by the desktop app is explicitly told which API to call back into, so it can't drift onto a stale port or channel.",
        "items": [
          {
            "text": "Threaded the desktop's bound server URL into the local harness sidecar via a new AURA_OS_SERVER_URL env var, ensuring the managed child calls back to the running desktop even when inherited settings or a stray .env would point it elsewhere.",
            "commit_shas": [
              "68f65436e21d71ddc24ddc830f096c9ca76a4773"
            ],
            "confidence": "high"
          },
          {
            "text": "Consolidated sidecar spawn and retry paths behind a single configure_sidecar_command helper and added a real subprocess test that verifies the child hits the desktop's project and specs endpoints.",
            "commit_shas": [
              "68f65436e21d71ddc24ddc830f096c9ca76a4773"
            ],
            "confidence": "high"
          }
        ]
      },
      {
        "batch_id": "entry-3",
        "time_label": "2:08 PM",
        "started_at": "2026-09-11T21:08:19.000Z",
        "ended_at": "2026-09-11T21:08:19.000Z",
        "title": "Interrupted chat turns reattach instead of silently resubmitting",
        "summary": "When a stream drops, the client now reattaches to the in-flight turn and cleans up stale boundaries instead of quietly resending the prompt.",
        "items": [
          {
            "text": "Reworked the agent chat stream to look up active streams and reattach to an interrupted turn by attach_id, avoiding a hidden prompt resubmission when the connection blips.",
            "commit_shas": [
              "acaddac37f2184125086b079d07745579caecd4c"
            ],
            "confidence": "high"
          },
          {
            "text": "Added a resetStreamForReplay lifecycle helper that drops transient assistant-boundary placeholders after the last user message so replays don't leave duplicate tool bubbles behind.",
            "commit_shas": [
              "acaddac37f2184125086b079d07745579caecd4c"
            ],
            "confidence": "high"
          },
          {
            "text": "Updated the dropped-stream error copy to \"Refresh to check saved progress. Restart turn sends your prompt again,\" matching the new Restart-turn semantics.",
            "commit_shas": [
              "acaddac37f2184125086b079d07745579caecd4c"
            ],
            "confidence": "high"
          }
        ]
      },
      {
        "batch_id": "entry-4",
        "time_label": "11:51 AM",
        "started_at": "2026-09-12T18:51:07.000Z",
        "ended_at": "2026-09-12T18:51:07.000Z",
        "title": "Mobile task stability and guarded iOS/Android release pipelines",
        "summary": "Mobile task hooks were stabilized and the native release workflows gained real safety rails around signing, store lanes, and build numbering.",
        "items": [
          {
            "text": "Hardened Android and iOS release workflows: keystore materialization now fails fast if the secret is missing and writes to RUNNER_TEMP with restrictive umask, store uploads are no longer cancelled by concurrent PR pushes, and the Android lane options were expanded to alpha/beta/production.",
            "commit_shas": [
              "ab0ea4e31c1b8ed5b719ca3c8def44ca30b6649d"
            ],
            "confidence": "high"
          },
          {
            "text": "Switched the native default host from the Render staging URL to api.aura.ai and derived a deterministic iOS build number from the run number, avoiding TestFlight collisions.",
            "commit_shas": [
              "ab0ea4e31c1b8ed5b719ca3c8def44ca30b6649d"
            ],
            "confidence": "high"
          },
          {
            "text": "Added a validate-native-release-host script plus a mobile-quality workflow, Fastlane test harness, and e2e mobile-readiness spec to keep native release configuration honest before shipping.",
            "commit_shas": [
              "ab0ea4e31c1b8ed5b719ca3c8def44ca30b6649d"
            ],
            "confidence": "high"
          },
          {
            "text": "Restructured mobile task updates, navigation, and the public/theme component layout, and added a dedicated MobileThemeToggleButton so shell surfaces stay stable across drawer and top-bar changes.",
            "commit_shas": [
              "ab0ea4e31c1b8ed5b719ca3c8def44ca30b6649d"
            ],
            "confidence": "medium"
          }
        ]
      },
      {
        "batch_id": "entry-5",
        "time_label": "1:02 PM",
        "started_at": "2026-09-14T20:02:24.000Z",
        "ended_at": "2026-09-14T20:02:24.000Z",
        "title": "Retired model providers hidden from the picker",
        "summary": "The chat model list now reflects what providers can actually serve, and stale saved selections gracefully fall back to the default.",
        "items": [
          {
            "text": "Removed models that production providers report as unavailable — including Claude Mythos 5.1, DeepSeek V4 Pro/Flash, MiniMax M2.7, GLM 5.1, and Qwen3 7 Plus — so the chat input bar only offers models we can route to.",
            "commit_shas": [
              "31643815f5563a89bcda251cea9b2c1c7dd0971b"
            ],
            "confidence": "high"
          },
          {
            "text": "Persisted selections pointing at retired model IDs now fall back to the default chat model instead of silently failing on send.",
            "commit_shas": [
              "31643815f5563a89bcda251cea9b2c1c7dd0971b"
            ],
            "confidence": "high"
          }
        ]
      }
    ],
    "highlights": [
      "Restart-turn wording replaces ambiguous Retry across chat",
      "Interrupted chat streams reattach without silently resending prompts",
      "Retired model providers hidden with automatic fallback to defaults",
