  "rendered": {
    "title": "Quick Prompts, conversation branching, and hosted Preview land together",
    "intro": "A feature-heavy nightly: a new Quick Prompt palette and voice dictation reshape the chat composer, conversations can now branch from any assistant reply, and Preview gains a production-grade hosted Chromium runtime with a remote-localhost tunnel for agent dev servers.",
    "entries": [
      {
        "batch_id": "entry-1",
        "time_label": "4:00 AM",
        "started_at": "2026-08-23T11:00:35.000Z",
        "ended_at": "2026-08-23T11:17:21.000Z",
        "title": "Quick Prompts, voice dictation, and conversation branching debut",
        "summary": "Three sizable chat features shipped back-to-back: a global Quick Prompt palette, in-composer voice dictation, and the ability to fork a conversation from any assistant reply.",
        "items": [
          {
            "text": "Introduced a Quick Prompt palette wired into the Aura shell and menu bar, letting users draft a prompt in a modal and hand it off to a chosen agent's chat composer via a new quick-prompt store.",
            "commit_shas": [
              "da686ae7f755c5815f7af3ac9ae26a1dd4b74776"
            ],
            "confidence": "high"
          },
          {
            "text": "Added voice dictation to the chat composer with a dedicated control, a reusable useVoiceDictation hook, and layout support in both desktop and mobile input bars.",
            "commit_shas": [
              "914e2478d69e8ed508260d94fd8cf2cfa79140a5"
            ],
            "confidence": "high"
          },
          {
            "text": "Enabled branching a conversation from any assistant reply: a new server-side branch_session endpoint copies events through the selected turn into a fresh active session, exposed via a Branch action in the message row.",
            "commit_shas": [
              "e01a708903ea0e506feb429aa71ffa8ea38c1d03"
            ],
            "confidence": "high"
          }
        ]
      },
      {
        "batch_id": "entry-2",
        "time_label": "8:03 AM",
        "started_at": "2026-08-23T15:03:59.000Z",
        "ended_at": "2026-08-23T16:21:05.000Z",
        "title": "Hosted Chromium runtime and Quick Prompt / branching follow-ups",
        "summary": "Preview gained a reproducible hosted Chromium runtime with a CI-verified container, while same-day fixes stabilized the freshly shipped Quick Prompt and branching flows.",
        "items": [
          {
            "text": "Shipped a production Dockerfile, .dockerignore, and an AURA API container workflow that builds the image, boots Chromium via CDP, and verifies the API becomes healthy as an unprivileged user — making hosted Preview deployable on Render and similar targets.",
            "commit_shas": [
              "4697c95bc3d1d7355f24b407eec4038be746f88e"
            ],
            "confidence": "high"
          },
          {
            "text": "Completed conversation branch navigation by routing through React Router instead of manual history events, re-enabling the branch action after completion, and surfacing an inline error when the branch request fails.",
            "commit_shas": [
              "d73f75c0cb635b2c55bddeb29893787491dcbcfc"
            ],
            "confidence": "high"
          },
          {
            "text": "Fixed Quick Prompt handoffs so they stay in the active Chat app lane (preserving project/instance/session) instead of stranding users on the standalone Agents surface, and preserved the route's agent selection during cold start while the agent roster is still hydrating.",
            "commit_shas": [
              "e142ab80afd65ad2618b1c7077d2a1beb80b6a23",
              "4c3113cf4758817e3bc722be44cfb2210bcac221"
            ],
            "confidence": "high"
          }
        ]
      },
      {
        "batch_id": "entry-3",
        "time_label": "9:37 PM",
        "started_at": "2026-08-24T04:37:16.000Z",
        "ended_at": "2026-08-24T04:37:16.000Z",
        "title": "Remote agent localhost tunneled into hosted Preview",
        "summary": "Preview can now reach a dev server running inside a selected remote agent by routing Chromium's loopback traffic through an authenticated per-browser SOCKS5 proxy to the swarm gateway.",
        "items": [
          {
            "text": "Added a remote_agent_id option on browser spawn that starts a per-session SOCKS5 proxy (remote_preview.rs) bridging Chromium to the agent's harness over the swarm's WebSocket gateway, while public destinations continue to connect directly from AURA OS.",
            "commit_shas": [
              "6e63ec176ed4e150a950934b1cc303114c299dc7"
            ],
            "confidence": "high"
          },
          {
            "text": "Disabled Chromium's implicit localhost proxy bypass for these sessions so loopback URLs are carried through the authenticated tunnel to the selected agent, with cleanup tokens tying proxy lifetime to the browser instance.",
            "commit_shas": [
              "6e63ec176ed4e150a950934b1cc303114c299dc7"
            ],
            "confidence": "high"
