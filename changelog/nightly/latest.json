  "rendered": {
    "title": "Clearer chat recovery, mobile release hardening, and a refreshed model lineup",
    "intro": "Today's nightly tightens how Aura recovers from dropped chat streams, sharpens the language around restarting turns and council roles, and cleans up the model picker so only providers that are actually live are offered. On the platform side, the desktop harness now reliably talks back to the right local server, and the mobile release pipelines gained stronger guardrails for iOS and Android store uploads.",
    "entries": [
      {
        "batch_id": "entry-1",
        "time_label": "9:38 AM",
        "started_at": "2026-09-11T16:38:54.000Z",
        "ended_at": "2026-09-11T16:38:54.000Z",
        "title": "Restart turn button and council role labels get plain-language wording",
        "summary": "Chat error affordances and Council Panel copy were rewritten so users understand what restarting a turn actually does and what each council slot contributes.",
        "items": [
          {
            "text": "Renamed the inline Retry control on dropped messages and the Stuck Stream pill to \"Restart turn,\" with a tooltip clarifying it resends the original prompt from the start rather than resuming unfinished work.",
            "commit_shas": [
              "a4907e2a1a4c8147a3d884dad2b2e97b203d1817"
            ],
            "confidence": "high"
          },
          {
            "text": "Replaced the Council Panel's cryptic \"slot 0\" mechanism subtitles with human-readable descriptions like \"1st member compares answers,\" and let the header wrap on narrow layouts.",
            "commit_shas": [
              "a4907e2a1a4c8147a3d884dad2b2e97b203d1817"
            ],
            "confidence": "high"
          }
        ]
      },
      {
        "batch_id": "entry-2",
        "time_label": "10:45 AM",
        "started_at": "2026-09-11T17:45:01.000Z",
        "ended_at": "2026-09-11T17:45:01.000Z",
        "title": "Desktop sidecar receives the real bound API address",
        "summary": "The managed local harness spawned by the desktop app now explicitly inherits the parent's server URL, preventing it from calling a stale channel or port from its own environment.",
        "items": [
          {
            "text": "The desktop app now passes its bound server URL into the harness via a new AURA_OS_SERVER_URL environment variable, routed through a shared configure_sidecar_command helper used by both the initial spawn and the fallback retry.",
            "commit_shas": [
              "68f65436e21d71ddc24ddc830f096c9ca76a4773"
            ],
            "confidence": "high"
          },
          {
            "text": "Added an end-to-end test that runs a real child process and asserts the managed harness issues its project and specs callbacks against the parent-provided address, catching cases where inherited .env values would otherwise win.",
            "commit_shas": [
              "68f65436e21d71ddc24ddc830f096c9ca76a4773"
            ],
            "confidence": "high"
          }
        ]
      },
      {
        "batch_id": "entry-3",
        "time_label": "2:08 PM",
        "started_at": "2026-09-11T21:08:19.000Z",
        "ended_at": "2026-09-11T21:08:19.000Z",
        "title": "Interrupted chat turns reattach instead of silently resubmitting",
        "summary": "The chat stream layer was reworked so a dropped connection can reattach to an in-flight turn and rebuild its view without duplicating tool bubbles or replaying the user's prompt behind their back.",
        "items": [
          {
            "text": "Introduced a resetStreamForReplay path that clears transient assistant boundaries after the last user message while relying on event-id dedupe for persisted events, so a full replay no longer leaves duplicate intermediate tool calls in the transcript.",
            "commit_shas": [
              "acaddac37f2184125086b079d07745579caecd4c"
            ],
            "confidence": "high"
          },
          {
            "text": "The agent chat stream now discovers reattachable active streams and resumes them in place, even across agent switches, instead of migrating the turn to a different agent.",
            "commit_shas": [
              "acaddac37f2184125086b079d07745579caecd4c"
            ],
            "confidence": "high"
          },
          {
            "text": "Updated the dropped-stream message from \"recovered from history\" to \"Refresh to check saved progress. Restart turn sends your prompt again,\" aligning the copy with the new Restart turn semantics.",
            "commit_shas": [
              "acaddac37f2184125086b079d07745579caecd4c"
            ],
            "confidence": "high"
          }
        ]
      },
      {
        "batch_id": "entry-4",
        "time_label": "11:51 AM",
        "started_at": "2026-09-12T18:51:07.000Z",
        "ended_at": "2026-09-12T18:51:07.000Z",
        "title": "Mobile task hooks stabilized and iOS/Android release lanes hardened",
        "summary": "A broad mobile pass tightened the useMobileTasks lifecycle and added guardrails around the native release pipelines for both stores, plus a new mobile-quality workflow and readiness docs.",
        "items": [
          {
            "text": "Reworked useMobileTasks with expanded test coverage to stabilize task update behavior, and reorganized the mobile shell with a new settings destination helper, extracted public landing/chat views, and a relocated theme toggle.",
            "commit_shas": [
              "ab0ea4e31c1b8ed5b719ca3c8def44ca30b6649d"
            ],
            "confidence": "high"
          },
          {
            "text": "Android and iOS workflows now default to the production api.aura.ai host, only cancel in-progress runs for pull requests so store uploads are never interrupted, and validate the Android upload keystore secret before decoding it into the runner temp dir.",
            "commit_shas": [
              "ab0ea4e31c1b8ed5b719ca3c8def44ca30b6649d"
            ],
            "confidence": "high"
          },
          {
