  "rendered": {
    "title": "Preview/Design modes land, plus universal agent cloning",
    "intro": "Today's nightly introduces a split Preview/Design experience for the in-app browser, backed by a new CDP inspection path on the server, and reworks agent cloning into a single flow that targets either local or remote machines. A quick follow-up also tightens the compact Preview toolbar so its controls stay legible in narrow panels.",
    "entries": [
      {
        "batch_id": "entry-1",
        "time_label": "3:28 AM",
        "started_at": "2026-08-10T10:28:06.000Z",
        "ended_at": "2026-08-10T10:28:06.000Z",
        "title": "Preview and Design modes for the in-app browser",
        "summary": "The browser panel gains a dedicated Design mode with an inspector and toolbar, powered by a new CDP-backed inspection path in the server.",
        "items": [
          {
            "text": "Added Preview and Design modes to the browser panel with a new BrowserDesignToolbar and BrowserDesignInspector, plus viewport presets and mode-aware viewport rendering.",
            "commit_shas": [
              "fe5f7b0be4b01ffe678272ec42ce74463d8e53a3"
            ],
            "confidence": "high"
          },
          {
            "text": "Wired element inspection end-to-end: a new Inspect client message and InspectionResult event flow through the CDP backend and the browser WebSocket handler, so Design mode can surface inspected nodes from a running Chromium.",
            "commit_shas": [
              "fe5f7b0be4b01ffe678272ec42ce74463d8e53a3"
            ],
            "confidence": "high"
          },
          {
            "text": "Enabled the Chromium/CDP backend on both dev and stable server channels so Preview and Design work in web-server builds alongside the desktop package, while feature-minimal builds can still opt out.",
            "commit_shas": [
              "fe5f7b0be4b01ffe678272ec42ce74463d8e53a3"
            ],
            "confidence": "high"
          }
        ]
      },
      {
        "batch_id": "entry-2",
        "time_label": "5:58 AM",
        "started_at": "2026-08-10T12:58:17.000Z",
        "ended_at": "2026-08-10T12:58:17.000Z",
        "title": "Compact Preview toolbar no longer clips in narrow panels",
        "summary": "A fast follow-up on the new Design toolbar keeps its controls visible and labeled when the browser panel gets tight.",
        "items": [
          {
            "text": "Switched the toolbar to a container query at 360px so mode buttons collapse to icons cleanly, and marked viewport and divider groups non-shrinkable to stop clipping in compact layouts.",
            "commit_shas": [
              "de66b3c2c2cb85b7ff460e020f8e9eeeac3db01a"
            ],
            "confidence": "high"
          },
          {
            "text": "Added aria-labels and titles to the Preview and Design mode buttons so the icon-only compact state stays accessible, backed by new regression tests for the toolbar.",
            "commit_shas": [
              "de66b3c2c2cb85b7ff460e020f8e9eeeac3db01a"
            ],
            "confidence": "high"
          }
        ]
      },
      {
        "batch_id": "entry-3",
        "time_label": "11:45 AM",
        "started_at": "2026-08-10T18:45:39.000Z",
        "ended_at": "2026-08-10T18:45:39.000Z",
        "title": "Unified agent cloning across local and remote machines",
        "summary": "Cloning is no longer a local-only side path — a single API and modal now handle both local and remote destinations, with tighter guardrails on outbound network requests.",
        "items": [
          {
            "text": "Replaced the local-only clone endpoint with a generalized CloneAgentRequest that takes an explicit machine_type (local or remote), collapsing the previous CloneAgentToLocal flow into one predictable create-only path.",
            "commit_shas": [
              "d0319906f6567a2815a582fe08839e42d10a026d"
            ],
            "confidence": "high"
          },
          {
            "text": "Reworked the agent info panel around a single CloneAgentModal (retiring CloneAgentToLocalModal) so users pick the destination in one place instead of navigating separate flows.",
            "commit_shas": [
              "d0319906f6567a2815a582fe08839e42d10a026d"
            ],
            "confidence": "high"
          },
          {
            "text": "Restricted authenticated network requests to expected origins in the shared network client, reducing the risk of credentials leaking to unintended hosts.",
            "commit_shas": [
              "d0319906f6567a2815a582fe08839e42d10a026d"
            ],
            "confidence": "medium"
          }
        ]
