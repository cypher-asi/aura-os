  "rendered": {
    "title": "Conversation management gets first-class controls",
    "intro": "Tonight's nightly rebuilds the chat sidebar around durable conversation management—archive, rename, and pin—while the composer picks up persistent drafts, an oversize-prompt guard, and a new global prompt shelf. A preview-only routing fix keeps local sessions from leaking onto the remote tunnel.",
    "entries": [
      {
        "batch_id": "entry-1",
        "time_label": "7:06 PM",
        "started_at": "2026-08-31T02:06:24.000Z",
        "ended_at": "2026-08-31T04:35:00.000Z",
        "title": "Archive, rename, and pin land in the sessions list",
        "summary": "The chat sidebar gains a full set of server-backed lifecycle controls so users can curate their conversation history across clients.",
        "items": [
          {
            "text": "Conversations can now be archived and restored from the sessions list, with the archived state stored server-side so the choice follows users across Aura clients; the same change also tightens authenticated storage request URLs.",
            "commit_shas": [
              "282eab40986b2cdc42cf69936109d5b11846dd0b"
            ],
            "confidence": "high"
          },
          {
            "text": "Sessions are renameable inline—user-authored titles replace the generated summary label and are validated up to 120 characters on the server.",
            "commit_shas": [
              "0abff91d34b884bdbddaf71f55915f39b56bff3c"
            ],
            "confidence": "high"
          },
          {
            "text": "Important conversations can be pinned to the top of the list via a new pin endpoint and `pinned_at` field flowing through core, storage, and the sidebar UI.",
            "commit_shas": [
              "8cf6fb283db5c97c2c4cd07b1408b52e1302532f"
            ],
            "confidence": "high"
          },
          {
            "text": "Composer drafts now persist to localStorage per stream key and rehydrate on init, so refreshing or reopening Aura no longer discards an unfinished prompt; a migration hook moves fresh-canvas drafts onto their assigned session key.",
            "commit_shas": [
              "6e9c37ca6480c78d59af1e8d646481fbc4e109b5"
            ],
            "confidence": "high"
          },
          {
            "text": "A new global prompt shelf lets users stash the current prompt with Cmd/Ctrl+S from the desktop composer and reopen saved prompts from a dedicated shelf on both desktop and mobile.",
            "commit_shas": [
              "694f2056d7ef98bb60d38846745fa68019a0567e"
            ],
            "confidence": "high"
          },
          {
            "text": "Oversized prompts now show an inline \"Remove N characters to send\" hint and disable the send button while keeping the textarea editable on both desktop and mobile.",
            "commit_shas": [
              "352081d5ddfde3fad7c220f5f6ce04c20cd98ef2"
            ],
            "confidence": "high"
          },
          {
            "text": "Preview builds no longer force Sidekick sessions through the remote tunnel: terminal routing now prefers the local workspace unless the client is remote-only, and a stale vite preview config was dropped.",
            "commit_shas": [
              "7c0c1fdd74b726874914a645597d63a8be95ea53"
            ],
            "confidence": "high"
          }
        ]
      }
    ],
    "highlights": [
      "Archive, rename, and pin conversations from the sessions list",
      "Global prompt shelf with Cmd+S to stash drafts",
      "Unfinished chat drafts survive restarts",
      "Oversize prompts are blocked without locking the editor"
    ],
    "raw_commit_count": 7
  }
